# ─── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
package-lock.json
*.tsbuildinfo

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ─── C build artifacts ────────────────────────────────────────────────────────
services/proxy/build/
services/proxy/uva-proxy

# ─── Next.js build output ─────────────────────────────────────────────────────
.next/

# ─── Databases ────────────────────────────────────────────────────────────────
services/proxy/proxy.db
services/proxy/proxy.db-shm
services/proxy/proxy.db-wal
*.db
*.db-shm
*.db-wal

# ─── Secrets / environment files ──────────────────────────────────────────────
services/proxy/proxy.env
*.env
.env
.env.*
!.env.example

# ─── Captured traffic (potentially sensitive) ─────────────────────────────────
upstream/capture/captured_traffic.json
upstream/capture/capture_summary.txt

# ─── Source maps (extracted source already in upstream/extracted/) ─────────────
upstream/bundles/*.map

# ─── Prettified bundle duplicates ─────────────────────────────────────────────
upstream/bundles/*_pretty.js

# ─── Raw HTML captures (not real API docs) ────────────────────────────────────
upstream/bundles/api_*.txt

# ─── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
