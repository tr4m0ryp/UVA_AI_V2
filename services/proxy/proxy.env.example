# UvA Proxy configuration
# Copy this file to proxy.env and fill in your values.
#
#   cp proxy.env.example proxy.env
#
# The proxy reads this file automatically on startup.

# ------------------------------------------------------------------
# REQUIRED: your UvA session cookie (obtained after logging in at
# https://aichat.uva.nl via Azure AD / UvA SSO).
#
# How to get it:
#   1. Open https://aichat.uva.nl in Chrome/Firefox.
#   2. Log in with your UvA credentials.
#   3. Open DevTools -> Application -> Cookies -> https://aichat.uva.nl
#   4. Copy the value of __Secure-next-auth.session-token
#   5. Paste the full "Name=Value" string below, e.g.:
#      UVA_SESSION_COOKIE="__Secure-next-auth.session-token=eyJ..."
#
# Alternatively run:  ./uva-proxy --login
# which opens a browser and captures the cookie automatically.
# ------------------------------------------------------------------
UVA_SESSION_COOKIE=""

# ------------------------------------------------------------------
# OPTIONAL: override the default API key accepted by the proxy.
# Defaults to "uva-local" when not set.
# Any key works when the proxy runs locally (no multi-user auth needed).
# ------------------------------------------------------------------
# UVA_PROXY_API_KEY="uva-local"

# ------------------------------------------------------------------
# OPTIONAL: override the default model used when none is specified
# in the request.  Available: gpt-5, gpt-5.1, gpt-5-mini, gpt-5-nano,
# gpt-4.1, gpt-4o, gpt-oss-120b
# ------------------------------------------------------------------
# UVA_DEFAULT_MODEL="gpt-5"

# ------------------------------------------------------------------
# OPTIONAL: GitHub OAuth app credentials (needed for cloud-coding /
# project management features).  Create an OAuth app at:
#   https://github.com/settings/developers
# Set the callback URL to: http://127.0.0.1:8787/api/dashboard/github/callback
# ------------------------------------------------------------------
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
