#!/bin/sh
set -e

cd "$(dirname "$0")"

PORT="${1:-8787}"

# Kill any existing instance
PID=$(lsof -ti :"$PORT" 2>/dev/null || true)
if [ -n "$PID" ]; then
    echo "Stopping existing uva-proxy (pid $PID)..."
    kill "$PID" 2>/dev/null || true
    sleep 1
fi

# Build
echo "Building..."
make -j"$(nproc)" 2>&1
echo ""

# Open browser after a short delay
(sleep 1 && xdg-open "http://127.0.0.1:${PORT}/dashboard" 2>/dev/null) &

# Run (serves both API + frontend on same port)
exec ./uva-proxy --port "$PORT"
