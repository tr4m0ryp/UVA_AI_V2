{
  "manifest_version": 3,
  "name": "UvA AI Session Sync",
  "version": "1.0.0",
  "description": "Automatically syncs UvA AI Chat session cookies to your proxy server.",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://aichat.uva.nl/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
