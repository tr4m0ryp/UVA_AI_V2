{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "uva-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "UvA Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:UVA_PROXY_API_KEY}"
      },
      "models": {
        "gpt-5": {
          "name": "GPT-5",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5.1": {
          "name": "GPT-5.1",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-5-nano": {
          "name": "GPT-5 Nano",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-oss-120b": {
          "name": "GPT OSS 120B",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      },
      "exclude": [
        "claude-sonnet-4.5",
        "claude-haiku-4.5",
        "o3",
        "o3-mini",
        "o1",
        "llama-3.3-70b",
        "mistral-large",
        "gpt-4.1-mini"
      ]
    }
  },
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "cors": [
      "http://127.0.0.1:5174",
      "http://localhost:5174"
    ]
  }
}
